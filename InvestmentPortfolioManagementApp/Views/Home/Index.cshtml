@{
    ViewData["Title"] = "Home";
}

<div class="container py-4">
    <div class="row align-items-start g-4">
        <div class="col-12 text-center mb-3">
            <h1 class="display-5">Welcome to Investment Portfolio Management System</h1>
            <p class="text-muted">Manage portfolios, track performance, assess risk, and generate reports.</p>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">Admin Login</div>
                <div class="card-body">
                    <p class="card-text">Login as administrator to manage users and system settings.</p>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-role="Admin">Login as Admin</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">Investor Login</div>
                <div class="card-body">
                    <p class="card-text">Login as investor to view and manage your portfolios.</p>
                    <a class="btn btn-success" asp-controller="Account" asp-action="Login" asp-route-role="Investor">Login as Investor</a>
                </div>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<InvestmentPortfolioManagementApp.Models.User>
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2 class="mb-3">Welcome, @ViewBag.UserName!</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Investors</h4>
    <a class="btn btn-primary" asp-action="CreateInvestor">Create Investor</a>
</div>

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger">@Html.Raw(err)</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var inv in Model)
    {
        <tr>
            <td>@inv.UserId</td>
            <td>@inv.UserName</td>
            <td>@inv.Email</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="EditInvestor" asp-route-id="@inv.UserId">Edit</a>
                <form asp-action="DeleteInvestor" asp-route-id="@inv.UserId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this investor?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

